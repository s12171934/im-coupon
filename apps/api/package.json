{
  "name": "@im-coupon/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --require @swc-node/register src/main.ts",
